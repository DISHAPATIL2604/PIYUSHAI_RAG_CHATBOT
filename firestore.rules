rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to ensure caller can only access their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document: users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Enrollments: users/{userId}/enrollments/{courseId}
      match /enrollments/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // Chats: users/{userId}/chats/{chatId}
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);

        // Messages: users/{userId}/chats/{chatId}/messages/{messageId}
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Deny all other collections and documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
