# LLM Provider: "ollama" (local/offline) or "groq" (cloud)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Groq (only needed when LLM_PROVIDER=groq)
GROQ_API_KEY=
YOUTUBE_API_KEY=
GROQ_MODEL=llama3-8b-8192
CHROMA_PERSIST_DIRECTORY=../data/chroma
BACKEND_CORS_ORIGINS=http://localhost:5173

# Admin protection for /api/v1/ingestion/* (send as X-Admin-Key header)
ADMIN_API_KEY=

# Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_REQUIRED=true

# Embeddings (configurable; default is all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_FETCH_K=15
RELEVANCE_THRESHOLD=0.35
MAX_CONTEXT_CHARS=6000

# Recommendations
RECOMMENDATION_MIN_SCORE=0.45
ALLOW_SAMPLE_DATA=false

# Generation (gpt-oss is a reasoning model, so it needs headroom for hidden reasoning tokens)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=30
SESSION_MAX_TURNS=6

# Crawling
CRAWL_USER_AGENT=PiyushAI-RAG-Bot/0.1 (educational project)
CRAWL_DELAY_SECONDS=1.0
CRAWL_MAX_PAGES=100
CRAWL_MAX_DEPTH=3
CRAWL_MIN_TEXT_CHARS=300
ENABLE_PLAYWRIGHT=false
